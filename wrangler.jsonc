{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "accessx-demo",
  "main": "worker.js",
  "compatibility_date": "2026-09-26",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/scim/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "accessx-demo",
      "database_id": "local-accessx-demo",
      "migrations_dir": "migrations"
    }
  ],
  // One TenantWriter per tenant serializes that tenant's writes (worker.js).
  "durable_objects": {
    "bindings": [{ "name": "TENANT_WRITER", "class_name": "TenantWriter" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TenantWriter"] }],
  // Reconcile credentials against policy every 15 minutes (worker.js scheduled()).
  "triggers": { "crons": ["*/15 * * * *"] },
  "vars": {
    "AUTH_OPEN_READS": "1"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
